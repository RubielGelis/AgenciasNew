{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/prequotations/layout,_N_T_/dashboard/prequotations/page,_N_T_/dashboard/prequotations"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/prequotations/__PAGE__",
    "/dashboard/prequotations",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}