generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
  theme    = "neutral"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id                   Int            @id @default(autoincrement())
  name                 String
  email                String         @unique
  passwordHash         String
  resetPasswordToken   String?        @unique
  resetPasswordExpires DateTime?
  roleId               Int
  branchId             Int?
  implantId            Int?
  ticketPrinterId      Int?
  quotations           Quotation[]
  logs                 SystemLog[]
  branch               Branch?        @relation(fields: [branchId], references: [id])
  implant              Implant?       @relation(fields: [implantId], references: [id])
  role                 Role           @relation(fields: [roleId], references: [id])
  ticketPrinter        TicketPrinter? @relation(fields: [ticketPrinterId], references: [id])
}

model Client {
  id          Int         @id @default(autoincrement())
  name        String
  document    String      @unique
  contactInfo String?
  address     String?
  quotations  Quotation[]
}

model Provider {
  id                Int                @id @default(autoincrement())
  code              String?            @unique
  name              String
  contactInfo       String?
  commissionConfig  Json?
  prestadoras       Prestadora[]
  quotationProducts QuotationProduct[]
  comboProducts     ComboProduct[]
}

model Prestadora {
  id                Int                @id @default(autoincrement())
  name              String
  type              String?
  location          String?
  category          String?
  providerId        Int
  code              String?            @unique
  provider          Provider           @relation(fields: [providerId], references: [id])
  quotationProducts QuotationProduct[]
  comboProducts     ComboProduct[]
}

model Branch {
  id         Int         @id @default(autoincrement())
  code       String      @unique
  name       String
  implants   Implant[]
  quotations Quotation[]
  users      User[]
}

model Implant {
  id         Int         @id @default(autoincrement())
  code       String      @unique
  name       String
  branchId   Int?
  branch     Branch?     @relation(fields: [branchId], references: [id])
  quotations Quotation[]
  users      User[]
}

model Seller {
  id         Int         @id @default(autoincrement())
  code       String?     @unique
  name       String
  email      String?
  quotations Quotation[]
}

model TicketPrinter {
  id         Int         @id @default(autoincrement())
  code       String?     @unique
  name       String
  email      String?
  quotations Quotation[]
  users      User[]
}

model Product {
  id                Int                @id @default(autoincrement())
  type              String
  description       String
  basePrice         Float
  billingConcept    String?
  serviceType       String?
  code              String?            @unique
  quotationProducts QuotationProduct[]
  comboProducts     ComboProduct[]
}

model Quotation {
  id                   Int                @id @default(autoincrement())
  internalNumber       String             @unique
  date                 DateTime           @default(now())
  clientId             Int
  currency             String
  exchangeRate         Float
  branchId             Int
  implantId            Int?
  sellerId             Int?
  ticketPrinterId      Int?
  baseCommissionable   Float
  commissionPercentage Float
  chargesAndTaxes      Float
  totalAmount          Float
  userId               Int?
  attachments          Attachment[]
  branch               Branch             @relation(fields: [branchId], references: [id])
  client               Client             @relation(fields: [clientId], references: [id])
  implant              Implant?           @relation(fields: [implantId], references: [id])
  seller               Seller?            @relation(fields: [sellerId], references: [id])
  ticketPrinter        TicketPrinter?     @relation(fields: [ticketPrinterId], references: [id])
  user                 User?              @relation(fields: [userId], references: [id])
  products             QuotationProduct[]
  combos               QuotationCombo[]
}

model QuotationCombo {
  id          Int       @id @default(autoincrement())
  quotationId Int
  comboId     Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  combo       Combo     @relation(fields: [comboId], references: [id])
}

model Attachment {
  id          Int       @id @default(autoincrement())
  quotationId Int
  fileName    String
  fileType    String
  fileSize    Int
  fileContent Bytes
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationProduct {
  id                      Int                         @id @default(autoincrement())
  quotationId             Int
  productId               Int
  quantity                Int
  price                   Float
  providerId              Int?
  prestadoraId            Int?
  checkInDate             DateTime?
  checkOutDate            DateTime?
  nights                  Int?
  paxAdults               Int?
  paxChildren             Int?
  serviceType             String?
  destination             String?
  reservationCode         String?
  sellerCommission        Float?
  ticketPrinterCommission Float?
  prestadora              Prestadora?                 @relation(fields: [prestadoraId], references: [id])
  product                 Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider                Provider?                   @relation(fields: [providerId], references: [id])
  quotation               Quotation                   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  passengers              QuotationProductPassenger[]
  appliedTaxes            QuotationProductTax[]
  variables               QuotationProductVariable[]
  comboId                 Int?
  mainTaxId               Int?
  inNationality           Int                         @default(1)
}

model QuotationProductPassenger {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  name               String
  document           String
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)

  @@map("QuotationProductPassenger")
}

model ChargeAndTax {
  id         Int                   @id @default(autoincrement())
  code       String?               @unique
  name       String
  type       String
  valueType  String
  value      Float
  isEditable Boolean               @default(true)
  appliedTo  QuotationProductTax[]
  comboTaxes ComboProductTax[]
}

model QuotationProductTax {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  chargeAndTaxId     Int
  valueSnapshot      Float
  valueTypeSnapshot  String
  explicitAmount     Float?
  isMain             Boolean          @default(false)
  chargeAndTax       ChargeAndTax     @relation(fields: [chargeAndTaxId], references: [id])
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  module      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model MasterVariable {
  id               Int                        @id @default(autoincrement())
  code             String                     @unique
  name             String
  productVariables QuotationProductVariable[]
}

model QuotationProductVariable {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  masterVariableId   Int
  value              String
  masterVariable     MasterVariable   @relation(fields: [masterVariableId], references: [id])
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
}

model SystemParameter {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String
  value String
}

model Combo {
  id             Int              @id @default(autoincrement())
  code           String           @unique
  name           String
  products       ComboProduct[]
  quotationCombos QuotationCombo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ComboProduct {
  id           Int               @id @default(autoincrement())
  comboId      Int
  productId    Int
  price        Float
  providerId   Int?
  prestadoraId Int?
  checkInDate  DateTime?
  checkOutDate DateTime?
  paxAdults    Int?
  paxChildren  Int?
  mainTaxId    Int?
  inNationality Int               @default(1)
  
  combo        Combo             @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id])
  provider     Provider?         @relation(fields: [providerId], references: [id])
  prestadora   Prestadora?       @relation(fields: [prestadoraId], references: [id])
  appliedTaxes ComboProductTax[]
}

model ComboProductTax {
  id             Int          @id @default(autoincrement())
  comboProductId Int
  chargeAndTaxId Int
  amount         Float
  isMain         Boolean      @default(false)
  
  comboProduct   ComboProduct @relation(fields: [comboProductId], references: [id], onDelete: Cascade)
  chargeAndTax   ChargeAndTax @relation(fields: [chargeAndTaxId], references: [id])
}
