generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
  theme    = "neutral"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  resetPasswordToken   String?  @unique
  resetPasswordExpires DateTime?
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  branchId     Int?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  implantId    Int?
  implant      Implant? @relation(fields: [implantId], references: [id])
  ticketPrinterId Int?
  ticketPrinter TicketPrinter? @relation(fields: [ticketPrinterId], references: [id])
  logs         SystemLog[]
}

model Client {
  id          Int         @id @default(autoincrement())
  name        String
  document    String      @unique
  contactInfo String?
  address     String?
  quotations  Quotation[]
}

model Provider {
  id               Int         @id @default(autoincrement())
  name             String
  contactInfo      String?
  commissionConfig Json?
  hotels           Hotel[]
  quotationProducts QuotationProduct[]
}

model Hotel {
  id         Int         @id @default(autoincrement())
  name       String
  location   String?
  category   String?
  providerId Int
  provider   Provider    @relation(fields: [providerId], references: [id])
  quotationProducts QuotationProduct[]
}

model Branch {
  id         Int         @id @default(autoincrement())
  code       String      @unique
  name       String
  quotations Quotation[]
  implants   Implant[]
  users      User[]
}

model Implant {
  id         Int         @id @default(autoincrement())
  code       String      @unique
  name       String
  branchId   Int? // Opcional por ahora para no romper datos existentes
  branch     Branch?     @relation(fields: [branchId], references: [id])
  quotations Quotation[]
  users      User[]
}

model Seller {
  id         Int         @id @default(autoincrement())
  code       String?     @unique
  name       String
  email      String?
  quotations Quotation[]
}

model TicketPrinter {
  id         Int         @id @default(autoincrement())
  code       String?     @unique
  name       String
  email      String?
  quotations Quotation[]
  users      User[]
}

model Product {
  id               Int                @id @default(autoincrement())
  type             String
  description      String
  basePrice        Float
  billingConcept   String? // Concepto de facturación libre
  serviceType      String? // Tipo de servicio libre
  quotationProducts QuotationProduct[]
}

model Quotation {
  id                   Int                  @id @default(autoincrement())
  internalNumber       String               @unique
  date                 DateTime             @default(now())
  clientId             Int
  client               Client               @relation(fields: [clientId], references: [id])
  currency             String
  exchangeRate         Float
  branchId             Int
  branch               Branch               @relation(fields: [branchId], references: [id])
  implantId            Int?
  implant              Implant?             @relation(fields: [implantId], references: [id])
  sellerId             Int?
  seller               Seller?              @relation(fields: [sellerId], references: [id])
  ticketPrinterId      Int?
  ticketPrinter        TicketPrinter?       @relation(fields: [ticketPrinterId], references: [id])
  baseCommissionable   Float
  commissionPercentage Float
  chargesAndTaxes      Float
  totalAmount          Float
  products             QuotationProduct[]
  attachments          Attachment[]
}

model Attachment {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  fileSize    Int
  fileContent Bytes // Almacena el contenido binario del archivo
  createdAt   DateTime  @default(now())
}

model QuotationProduct {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  price       Float

  // Per-product passenger and provider details
  providerId  Int?
  provider    Provider? @relation(fields: [providerId], references: [id])
  hotelId     Int?
  hotel       Hotel?    @relation(fields: [hotelId], references: [id])
  checkInDate DateTime?
  checkOutDate DateTime?
  nights      Int?
  
  // Passenger details support multiple
  passengers  QuotationProductPassenger[]
  paxAdults            Int?
  paxChildren          Int?

  // Service specifics
  serviceType          String?
  destination          String?
  reservationCode      String?

  // Commissions specific to this product
  sellerCommission         Float?
  ticketPrinterCommission  Float?

  appliedTaxes QuotationProductTax[]
  variables    QuotationProductVariable[]
}

model QuotationProductPassenger {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
  name               String
  document           String

  @@map("QuotationProductPassenger")
}


model ChargeAndTax {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   // e.g., "TAX" (Impuestos), "CHARGE" (Cargos), "COMMISSION" (Comisión)
  valueType   String   // e.g., "PERCENTAGE", "FIXED"
  value       Float
  isEditable  Boolean  @default(true)

  appliedTo   QuotationProductTax[]
}

model QuotationProductTax {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
  chargeAndTaxId     Int
  chargeAndTax       ChargeAndTax     @relation(fields: [chargeAndTaxId], references: [id], onDelete: Restrict)
  
  // Guardamos un snapshot del valor al momento de cotizar para evitar que cambios futuros en el maestro alteren cotizaciones pasadas
  valueSnapshot      Float
  valueTypeSnapshot  String
  explicitAmount     Float? // Almacena el valor monetario exacto ingresado o calculado
}


model SystemLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // LOGIN, CREATE, UPDATE, DELETE, IMPORT
  module      String   // USER, QUOTATION, MASTER_DATA (HOTEL, PROVIDER, etc.)
  description String   // A human-readable description of what happened
  metadata    Json?    // Optional technical dump of the changed data or payload
  createdAt   DateTime @default(now())
}

model MasterVariable {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String

  productVariables QuotationProductVariable[]
}

model QuotationProductVariable {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
  masterVariableId   Int
  masterVariable     MasterVariable   @relation(fields: [masterVariableId], references: [id], onDelete: Restrict)
  
  value              String
}

